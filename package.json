{
  "name": "tree-sitter-gia",
  "version": "0.1.3",
  "description": "Tree-sitter grammar for the Gia programming language",
  "main": "bindings/node",
  "types": "bindings/node",
  "exports": {
    ".": {
      "types": "./bindings/node/index.d.ts",
      "default": "./bindings/node/index.js"
    },
    "./wasm": {
      "types": "./bindings/web/wasm.d.ts",
      "default": "./bindings/web/wasm.js"
    },
    "./queries/highlights": {
      "types": "./queries/highlights.d.ts",
      "default": "./queries/highlights.js"
    }
  },
  "keywords": [
    "incremental",
    "parser",
    "parsing",
    "tree-sitter",
    "gia",
    "language"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gia-language/gia-treesitter.git"
  },
  "bugs": {
    "url": "https://github.com/gia-language/gia-treesitter/issues"
  },
  "homepage": "https://github.com/gia-language/gia-treesitter#readme",
  "files": [
    "bindings/node/*",
    "bindings/web/*",
    "binding.gyp",
    "grammar.js",
    "LICENSE",
    "queries/*",
    "README.md",
    "src/**",
    "tree-sitter-gia.wasm",
    "tree-sitter.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "build": "node-gyp rebuild",
    "build:wasm": "node scripts/build-wasm.mjs",
    "install": "node-gyp-build || node-gyp rebuild",
    "parse": "tree-sitter parse",
    "smoke-test": "node --test bindings/node/*_test.js bindings/web/*_test.mjs",
    "test:native": "tree-sitter test && node --test bindings/node/*_test.js",
    "test:wasm": "node --test bindings/web/*_test.mjs",
    "test": "npm run test:native && npm run build:wasm && npm run test:wasm",
    "verify:native": "npm run generate && npm run build && npm run test:native",
    "verify:wasm": "npm run build:wasm && npm run test:wasm",
    "verify": "npm run verify:native && npm run verify:wasm",
    "prepack": "npm run generate && npm run build:wasm",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.25.0",
    "web-tree-sitter": "^0.25.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "tree-sitter": [
    {
      "scope": "source.gia",
      "file-types": [
        "gia"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "folds": "queries/folds.scm"
    }
  ]
}
